# ========================================
# Agora Token Service - Configuration
# ========================================

# Основные настройки
ENVIRONMENT=development
APP_NAME=Agora Token Service
APP_VERSION=1.0.0
DEBUG=true

# ========================================
# Сервер
# ========================================
HOST=0.0.0.0
PORT=8001
WORKERS=4
THREADS=2
WORKER_TIMEOUT=30
KEEPALIVE=5
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# ========================================
# База данных (PostgreSQL)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agora_token
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
# DATABASE_URL будет сформирована автоматически
# DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/agora_token

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false
REDIS_DB=0
REDIS_TIMEOUT=5

AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_RTC_TOKEN_EXPIRY=3600
AGORA_RTM_TOKEN_EXPIRY=86400
AGORA_TOKEN_CACHE_ENABLED=true
AGORA_TOKEN_CACHE_TTL=1800

SECRET_KEY=change_this_very_long_secret_key_32_chars_min
API_KEY=your_api_key_here
API_KEYS=["your_api_key_here"]
API_KEY_HEADER=X-API-Key

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8001"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log

HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false
METRICS_PORT=9090

RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

DOCS_ENABLED=true
OPENAPI_URL=/openapi.json

CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_BACKEND=redis

JWT_SECRET=change_this_jwt_secret_key_32_chars_min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
