
# Основные настройки
ENVIRONMENT=production
APP_NAME=Agora Token Service
APP_VERSION=1.0.0
DEBUG=true


# Сервер
HOST=0.0.0.0
PORT=8000
WORKERS=8
THREADS=4
WORKER_TIMEOUT=30
KEEPALIVE=5
GUNICORN_WORKERS=8
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30

# База данных
DB_HOST=postgres
DB_PORT=5432
DB_NAME=agora_service
DB_USER=agora_user
DB_PASSWORD=agora_password
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Wb_Sync2024!
REDIS_ENABLED=true
REDIS_DB=0
REDIS_TIMEOUT=5

# Agora
AGORA_APP_ID=e9b9e5c0daba4abfbb7a2bf57485dbc5
AGORA_APP_CERTIFICATE=fe172b9e3a9a4924bef163abc0259c92
AGORA_RTC_TOKEN_EXPIRY=3600
AGORA_RTM_TOKEN_EXPIRY=86400
AGORA_TOKEN_CACHE_ENABLED=true
AGORA_TOKEN_CACHE_TTL=1800

# Безопасность
SECRET_KEY=hTfpEYB1A8olLGEKPasct5dMflyuI1cX6BmfAdFLksw
API_KEY=PeEJukRPmF5H79FFU9ZpeuOkZX0IN2sI
API_KEYS=["PeEJukRPmF5H79FFU9ZpeuOkZX0IN2sI"]
API_KEY_HEADER=X-API-Key

# CORS - теперь в формате JSON
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Логирование
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/agora-service/app.log

# Мониторинг
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
METRICS_PORT=9090

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=50/minute
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_PERIOD=60

# Документация
DOCS_ENABLED=true
OPENAPI_URL=/openapi.json

# Кеширование
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_BACKEND=redis

# JWT
JWT_SECRET=hTfpEYB1A8olLGEKPasct5dMflyuI1cX6BmfAdFLksw
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7