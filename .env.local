

# Режим работы
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# База данных (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=agora_service
DB_USER=agora_user
DB_PASSWORD=agora_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# Agora
AGORA_APP_ID=your_app_id_here
AGORA_APP_CERTIFICATE=your_app_certificate_here
AGORA_RTC_TOKEN_EXPIRY=3600
AGORA_RTM_TOKEN_EXPIRY=86400

# Безопасность
SECRET_KEY=your-super-secret-key-change-in-production
API_KEY=your-api-key-for-external-access
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=900

# Мониторинг
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false

# pgAdmin
PGADMIN_EMAIL=admin@agora.local
PGADMIN_PASSWORD=admin123

# Redis Commander
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# Production настройки (для docker-compose.prod.yml)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
API_PORT=8000