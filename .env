# ============================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ============================================

# Режим работы
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# База данных (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=agora_service
DB_USER=agora_user
DB_PASSWORD=agora_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# Agora
AGORA_APP_ID=e9b9e5c0daba4abfbb7a2bf57485dbc5
AGORA_APP_CERTIFICATE=fe172b9e3a9a4924bef163abc0259c92
AGORA_RTC_TOKEN_EXPIRY=3600
AGORA_RTM_TOKEN_EXPIRY=86400

# Безопасность
SECRET_KEY=hTfpEYB1A8olLGEKPasct5dMflyuI1cX6BmfAdFLksw
API_KEY=PeEJukRPmF5H79FFU9ZpeuOkZX0IN2sI
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=900

# Мониторинг
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false

# pgAdmin
PGADMIN_EMAIL=admin@agora.local
PGADMIN_PASSWORD=admin123

# Redis Commander
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# Production настройки (для docker-compose.prod.yml)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
API_PORT=8000